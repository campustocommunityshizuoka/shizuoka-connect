    list-style: none; 
    padding: 0; 
    margin-top: 1rem; 
    border: 1px solid #eee; 
    border-radius: 4px;
}
.admin-item { 
    padding: 1rem; 
    border-bottom: 1px solid #eee; 
    background: #fff; 
    display: flex; 
    flex-direction: column; 
    gap: 0.5rem; 
}
.admin-item:last-child { 
    border-bottom: none; 
}

.item-header { 
    display: flex; 
    justify-content: space-between; 
    align-items: flex-start; 
    flex-wrap: wrap; 
    gap: 10px; 
}
.item-date { 
    font-size: 0.85rem; 
    color: #666; 
    display: block;
}
.item-title { 
    font-weight: bold; 
    color: #1A71BE; 
    font-size: 1.1rem; 
}
.item-details { 
    font-size: 0.95rem; 
    color: #333; 
    line-height: 1.5; 
    background: #f9f9f9; 
    padding: 0.8rem; 
    border-radius: 4px; 
    margin-top: 0.5rem;
}

/* タブメニュー */
.tab-menu { 
    display: flex; 
    gap: 5px; 
    margin-bottom: 1rem; 
    flex-wrap: wrap; 
}
.tab-btn { 
    flex: 1; 
    padding: 10px; 
    border: none; 
    background: #ddd; 
    cursor: pointer; 
    border-radius: 4px; 
    font-weight: bold; 
    white-space: nowrap; 
    font-size: 0.9rem; 
    color: #555;
    transition: all 0.3s;
}
.tab-btn:hover {
    background: #ccc;
}
.tab-btn.active { 
    background: #1A71BE; 
    color: white; 
}

/* ボタン類 */
.btn-group { 
    display: flex; 
    gap: 5px; 
}
.btn-delete { 
