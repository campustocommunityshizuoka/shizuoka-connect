    border: none; 
    padding: 5px 10px; 
    border-radius: 4px; 
    cursor: pointer; 
    font-size: 0.9rem;
}
.btn-preview { 
    background-color: #e67e22; 
    color: white; 
    border: none; 
    padding: 10px 15px; 
    border-radius: 4px; 
    cursor: pointer; 
    font-size: 0.9rem;
    font-weight: bold;
}
.btn-cancel { 
    background-color: #6c757d; 
    color: white; 
    border: none; 
    padding: 12px 20px; 
