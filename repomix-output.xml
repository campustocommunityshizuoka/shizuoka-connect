  overflow-y: auto;
  font-size: 0.9rem;
  margin-bottom: 1rem;
  line-height: 1.6;
}

.privacy-policy-box h4 {
  margin-top: 0;
  margin-bottom: 0.5rem;
}

.form-group-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-group-checkbox input[type="checkbox"] {
  margin-right: 0.75rem;
  width: auto;
}

.form-group-checkbox label {
