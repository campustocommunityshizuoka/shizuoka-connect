/* =================================================================
   スマホメニュー表示修正 (Z-index階層の適正化)
   ================================================================= */

/* 1. ハンバーガーボタン（×印）を「最強の最前面」にします */
.hamburger {
  z-index: 2002 !important; /* メニューよりさらに手前に */
}

/* 2. メニュー画面を「ヘッダーより手前」に持ってきます */
.nav-menu {
  z-index: 2001 !important; /* 元のヘッダー(1002)より大きな数字にする */
  
  /* 以前の修正の念押し設定 */
  justify-content: flex-start !important; /* 上詰め配置 */
  padding-top: 80px !important;           /* ×ボタンと被らないよう上に余白 */
  padding-bottom: 50px !important;        /* 下にも余白 */
  overflow-y: auto !important;            /* スクロール許可 */
}

/* 3. (念のため) ヘッダー本体はそのまま奥に配置 */
header {
  z-index: 1002; /* 変更なし（メニューの2001より小さいので裏に行きます） */
}

/* =================================================================
   メニュー内蔵「閉じるボタン(×)」の設定
   ================================================================= */

/* ボタンの枠と配置 */
.menu-close-btn {
    display: block;
    position: absolute;
    top: 25px;    /* メニュー上端からの距離 */
    right: 25px;  /* メニュー右端からの距離 */
    width: 35px;  /* クリックしやすいサイズに */
    height: 35px;
    cursor: pointer;
    z-index: 2005; /* メニュー文字より手前に */
}

/* ×印を作る2本の白い線 */
.menu-close-btn span {
    display: block;
    position: absolute;
    width: 100%;
    height: 3px;         /* 線の太さ */
    background-color: white; 
    border-radius: 4px;
    top: 16px;           /* 枠の中央に配置 */
    left: 0;
}

/* 1本目を45度回転 */
.menu-close-btn span:nth-child(1) {
    transform: rotate(45deg);
}

/* 2本目を-45度回転 */
.menu-close-btn span:nth-child(2) {
    transform: rotate(-45deg);
}

/* 【重要】メニューが開いている時は、ヘッダー裏の古いボタンを隠す */
/* これで二重にボタンが表示されるのを防ぎます */
.hamburger.active {
    opacity: 0 !important;
    pointer-events: none;
}
