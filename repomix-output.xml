}

.news-article-content {
  line-height: 1.9; /* 行間を広げて読みやすく */
  font-size: 1.05rem;
}

.news-article-content p {
  margin-bottom: 1.5rem;
}

.back-to-list {
  text-align: center;
  margin-top: 3rem;
}
/* =================================================================
   セクションタイトルをリンクにした際のスタイル
   ================================================================= */
.section-title a {
  color: inherit; /* 親要素（h2）の文字色をそのまま使用する */
  text-decoration: none; /* 下線を非表示にする */
}

/* タイトルリンクにカーソルを合わせた時に下線を表示 */
.section-title a:hover {
  text-decoration: underline;
}
/* =================================================================
   パートナーページの追加ボタンスタイル
   ================================================================= */

/* ボタンを横並びにするための設定 */
.partner-card-buttons {
  display: flex;
  justify-content: center;
  gap: 1rem; /* ボタンの間の隙間 */
  margin-top: auto; /* カード下部にボタンを配置 */
  padding-top: 1rem; /* 説明文との間に余白を確保 */
}

/* ボタンのアイコンとテキストの間の余白 */
.partner-card-buttons .btn i {
  margin-right: 0.5rem;
}

/* 「追加資料」ボタンのデザイン */
.btn.btn-secondary {
  background-color: #6c757d; /* グレー系の背景色 */
}

.btn.btn-secondary:hover {
  background-color: #5a6268; /* ホバー時にも少し濃いグレーに */
}

/* =================================================================
   パートナーカード スライドショースタイル
================================================================= */
.slideshow-container {
  position: relative;
  width: 100%;
  max-width: 320px;
  height: 200px;
  margin-bottom: 1.5rem;
  background-color: transparent;
  /* overflow: hidden; を削除 */
}

.slide {
  display: none; /* 初期状態では非表示 */
  width: 100%;
  height: 100%;
  /* ▼ 画像を中央揃えにするためのFlexbox設定 ▼ */
  display: flex;
  align-items: center;
  justify-content: center;
  /* ▲ 画像を中央揃えにするためのFlexbox設定 ▲ */
  /* position: absolute; を削除 */
}

.slide img {
  display: block; /* 不要な余白を削除 */
  width: 100%;    /* コンテナの幅に合わせる */
  height: 100%;   /* コンテナの高さに合わせる */
  object-fit: contain; /* アスペクト比を維持してフィット */
  /* ▼ 画像を中央に配置する代替方法 (position + transform) ▼ */
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  max-width: 100%;  /* コンテナを超えないように */
  max-height: 100%; /* コンテナを超えないように */
  /* ▲ 画像を中央に配置する代替方法 ▲ */
}

.active-slide {
  display: flex; /* Flexbox設定をここにも適用 */
  /* ▼ レイアウトをリセット ▼ */
  position: static;
  /* ▲ レイアウトをリセット ▲ */
}

.prev, .next {
  cursor: pointer;
  position: absolute;
  top: 50%;
  width: auto;
  margin-top: -22px;
  padding: 10px;
  color: white;
  font-weight: bold;
  font-size: 16px;
  transition: background-color 0.3s ease;
  border-radius: 0 3px 3px 0;
  user-select: none;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 5; /* 画像の上に表示されるように */
}

.next {
  right: 0;
  border-radius: 3px 0 0 3px;
}

.prev {
  left: 0;
}

.prev:hover, .next:hover {
  background-color: rgba(0, 0, 0, 0.7);
}
/* =================================================================
   トップページ 活動カード（写真付き）
================================================================= */

/* カード上部に表示する画像エリア */
.service-card .card-image {
  width: calc(100% + 4rem); /* カードのpadding(2rem*2)を打ち消す幅 */
  height: 180px;
  overflow: hidden;
  margin: -2rem -2rem 1.5rem -2rem; /* カードのpaddingを相殺して上部に配置 */
  border-radius: 8px 8px 0 0;
}

.service-card .card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 画像の比率を保ったままエリアを埋める */
  transition: transform 0.3s ease;
}

/* ホバー時に画像を少し拡大するエフェクト */
.service-card:hover .card-image img {
  transform: scale(1.05);
}

/* 写真付きカード（.card-icon-only が *ない* もの）のアイコンを非表示 */
.service-card:not(.card-icon-only) .icon {
  display: none;
}

/* 写真付きカードの h3 と p だけ左揃えにする */
/* （カード全体の text-align: center は .card クラスで定義されています） */
.service-card:not(.card-icon-only) h3,
.service-card:not(.card-icon-only) p {
  text-align: left;
}

/* アイコンのみのカード（.card-icon-only が *ある* もの）の画像は非表示 */
.card-icon-only .card-image {
  display: none;
}

/* カード全体を「画面に合わせて伸縮する箱」に変える */
.service-card {
  width: 100%;              /* 親要素の幅いっぱいに広がる */
  max-width: 100%;          /* 画面からはみ出さないように制限 */
  box-sizing: border-box;   /* 余白(padding)を含めて幅を計算させる（重要） */
  margin: 0 auto 20px auto; /* 中央寄せ & 下に少し余白 */
  
  /* もし古いコードで固定幅(300pxなど)が残っていても強制解除する */
  min-width: auto !important; 
}

/* 画像を入れている枠（もしあれば） */
.card-image {
  width: 100%;              /* 枠も幅いっぱいに */
}

/* 画像自体を「枠に合わせて伸縮する」ようにする */
.service-card img {
  width: 100%;              /* 横幅は常に親要素と同じにする（これではみ出し防止） */
  height: auto;             /* 横幅に合わせて高さは自動調整（これで画像が歪まない） */
  object-fit: cover;        /* 枠に合わせてトリミングして綺麗に見せる */
  display: block;           /* 画像下の微妙な隙間を消す */
  border-radius: 5px 5px 0 0; /* 上の角を少し丸める（お好みで） */
}

/* =================================================================
   Grow Upグループ セクション (緑基調・リッチデザイン)
================================================================= */
.grow-up-card {
  background: linear-gradient(135deg, #ffffff 0%, #f1f8e9 100%); /* 白から薄い緑へのグラデーション */
  border-radius: 12px; /* 角丸を少し大きく */
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05); /* 柔らかく広がる影 */
  padding: 3.5rem 4rem;
  margin: 5rem auto;
  max-width: 900px;
  border-top: 6px solid #2e7d32; /* 上部に濃い緑のアクセントライン */
  position: relative;
  overflow: hidden;
}

/* 背景に装飾として薄い円を配置（オシャレ感アップ） */
.grow-up-card::before {
  content: '';
  position: absolute;
  top: -50px;
  right: -50px;
  width: 150px;
  height: 150px;
  background-color: rgba(76, 175, 80, 0.1); /* 薄い緑 */
  border-radius: 50%;
  z-index: 0;
}

.grow-up-card h3 {
  color: #2e7d32; /* テキストを濃い緑に */
  font-size: 2rem;
  font-weight: 700;
  margin-top: 0;
  margin-bottom: 1.5rem;
  text-align: left;
  position: relative;
  z-index: 1;
  border-bottom: 2px solid #a5d6a7; /* 見出しの下に薄い緑の線 */
  padding-bottom: 0.5rem;
  display: inline-block; /* 線の長さを文字に合わせる */
}

.grow-up-card p {
  margin-bottom: 3rem;
  line-height: 1.9; /* 行間を広げて読みやすく */
  text-align: left;
  color: #37474f; /* 文字色は少し青みがかったダークグレーで知的に */
  font-size: 1.05rem;
  position: relative;
  z-index: 1;
}

/* ボタンを中央に配置するためのラッパー */
.grow-up-btn-wrapper {
  text-align: center;
  position: relative;
  z-index: 1;
}

/* 緑色のグラデーションボタン */
.grow-up-btn-wrapper .btn {
  background: linear-gradient(45deg, #43a047, #66bb6a); /* 緑のグラデーション */
  color: white;
  padding: 1rem 3rem; /* 大きめのボタン */
  font-size: 1.1rem;
  border-radius: 50px; /* 丸みのあるピル型ボタン */
  box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3); /* 緑色の影 */
  transition: all 0.3s ease;
  border: none;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.grow-up-btn-wrapper .btn:hover {
  transform: translateY(-3px); /* ホバー時に少し浮く */
  box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
  background: linear-gradient(45deg, #2e7d32, #43a047); /* ホバー時は少し濃く */
}

/* スマホ表示時の調整 */
@media (max-width: 768px) {
  .grow-up-card {
    padding: 2rem;
    margin: 3rem 1rem; /* スマホでは横幅いっぱいにしない */
  }
  .grow-up-card h3 {
    font-size: 1.5rem;
    display: block; /* スマホでは下線を全幅に */
  }
}
