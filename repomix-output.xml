/* --- 全体設定のアップデート --- */
body {
    font-family: 'Noto Sans JP', 'Helvetica Neue', Arial, sans-serif;
    background-color: #F8F9FA; /* よりクリーンな白に近いグレー */
    color: #333;
}

.section-header {
    text-align: center;
    margin-bottom: 3rem;
}

.section-title-modern {
    font-family: 'Poppins', sans-serif;
    font-size: 2.5rem;
    color: #1A71BE;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
    position: relative;
    display: inline-block;
}

/* タイトル下の装飾線 */
.section-title-modern::after {
    content: '';
    display: block;
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, #1A71BE, #64b5f6);
    margin: 10px auto 0;
    border-radius: 2px;
}

.section-desc {
    color: #666;
    font-size: 1rem;
    margin-top: 0.5rem;
}

/* --- ヘッダーナビの強調ボタン --- */
.nav-btn-highlight {
    background-color: #fff;
    color: #1A71BE !important;
    border-radius: 20px;
    padding: 0.5rem 1.2rem !important;
    margin-left: 10px;
    transition: all 0.3s;
}
.nav-btn-highlight:hover {
    background-color: #e3f2fd;
    transform: translateY(-2px);
}

.nav-btn-highlight-outline {
    border: 1px solid #fff;
    border-radius: 20px;
    padding: 0.4rem 1.2rem !important;
    margin-left: 10px;
    transition: all 0.3s;
}
.nav-btn-highlight-outline:hover {
    background-color: rgba(255,255,255,0.1);
}

/* --- モダンヒーローセクション --- */
.modern-hero {
    position: relative;
    height: 85vh; /* 画面の85%の高さ */
    min-height: 500px;
    /* 背景画像：Unsplashからのフリー素材（茶畑と富士山） */
    background-image: url('/assets/taki-n.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed; /* パララックス効果 */
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
}

/* 画像を暗くして文字を読ませるフィルター */
.hero-bg-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(135deg, rgba(26, 113, 190, 0.85), rgba(0, 0, 0, 0.4));
    z-index: 1;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    animation: fadeInUp 1s ease-out;
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
    text-shadow: 0 4px 10px rgba(0,0,0,0.3);
}

.text-gradient {
    color: #8FD3F4; /* 水色アクセント */
}

.hero-subtitle {
    font-size: 1.2rem;
    line-height: 1.8;
    margin-bottom: 2.5rem;
    opacity: 0.9;
}

.btn-hero {
    background: white;
    color: #1A71BE;
    padding: 1rem 3rem;
    border-radius: 50px;
    font-size: 1.1rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}
.btn-hero:hover {
    background: #f0f8ff;
    transform: translateY(-3px);
}

/* --- ニュースティッカー --- */
.news-ticker-wrapper {
    background: white;
    border-bottom: 1px solid #eee;
    padding: 0.8rem 0;
    box-shadow: 0 2px 5px rgba(0,0,0,0.03);
}
.news-ticker-flex {
    display: flex;
    align-items: center;
}
.news-label {
    background: #1A71BE;
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
    padding: 3px 8px;
    border-radius: 4px;
    margin-right: 15px;
}
.news-content a {
    color: #333;
    font-size: 0.9rem;
    font-weight: 500;
}
.news-content a:hover {
    color: #1A71BE;
    text-decoration: underline;
}

/* --- 役割選択カード（モダン版） --- */
.modern-role-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
}

.modern-role-card {
    position: relative;
    height: 350px;
    border-radius: 16px;
    overflow: hidden;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: flex-end; /* 下寄せ */
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
}

.modern-role-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
}

.card-bg-img {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s ease;
    z-index: 1;
}

/* ホバー時に背景画像を少し拡大 */
.modern-role-card:hover .card-bg-img {
    transform: scale(1.1);
}

/* オーバーレイグラデーション */
.modern-role-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    /* 下に行くほど暗くなるグラデーション */
    background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);
    z-index: 2;
}

.card-content {
    position: relative;
    z-index: 3;
    padding: 2.5rem;
}

.icon-circle {
    background: rgba(255,255,255,0.2);
    width: 60px; height: 60px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 1rem;
    backdrop-filter: blur(5px);
}

.modern-role-card h3 {
    font-size: 1.8rem;
    margin: 0 0 0.5rem 0;
    color: white;
}

.modern-role-card p {
    font-size: 0.95rem;
    opacity: 0.9;
    line-height: 1.5;
    margin-bottom: 0;
}

.card-arrow {
    position: absolute;
    bottom: 2rem; right: 2rem;
    font-size: 1.5rem;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s;
}

.modern-role-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
}

/* --- モダンプロジェクトカード --- */
.modern-project-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    transition: all 0.3s;
    border: 1px solid #eee;
}
.modern-project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.1);
}
.project-img {
    height: 200px;
    width: 100%;
    position: relative;
    overflow: hidden;
}
.project-img img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s;
}
.modern-project-card:hover .project-img img {
    transform: scale(1.05);
}
.category-tag {
    position: absolute;
    top: 15px; left: 15px;
    font-size: 0.8rem;
    font-weight: bold;
    padding: 4px 10px;
    border-radius: 4px;
    color: white;
}
.tag-recruit { background: #E74C3C; }
.tag-edu { background: #F39C12; }

.project-body {
    padding: 1.5rem;
    text-align: left; /* 左揃えに変更 */
}
.project-body h3 {
    font-size: 1.25rem;
    margin: 0 0 0.8rem 0;
    color: #333;
}
.project-body p {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 1.2rem;
}
.text-link {
    color: #1A71BE;
    font-weight: bold;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 5px;
}
.text-link:hover { text-decoration: underline; }

/* --- モダンCTAセクション --- */
.modern-cta {
    background: linear-gradient(135deg, #1A71BE, #0D47A1);
    border-radius: 10px;
    padding: 5rem 2rem;
    text-align: center;
    color: white;
    position: relative;
    overflow: hidden;
    margin-top: 6rem;
}
.cta-bg-shape {
    position: absolute;
    top: -50%; left: -20%;
    width: 600px; height: 600px;
    background: rgba(255,255,255,0.05);
    border-radius: 50%;
}
.cta-content {
    position: relative; z-index: 2;
}
.cta-content h2 {
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
}
.btn-white {
    background: white;
    color: #1A71BE;
    padding: 1rem 3rem;
    border-radius: 50px;
    font-weight: bold;
    margin-top: 2rem;
    display: inline-block;
    transition: all 0.3s;
}
.btn-white:hover {
    background: #f0f0f0;
    transform: scale(1.05);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
