/* --- 1. メンバー・顧問画像の強制サイズ固定 (崩壊防止) --- */
/* 画像を囲む枠を作り、強制的にサイズを固定します */
.member-img-wrapper {
    width: 180px;          /* 横幅固定 */
    height: 180px;         /* 高さ固定 */
    margin: 0 auto 1.5rem; /* 中央寄せ */
    border-radius: 50%;    /* 丸くする */
    overflow: hidden;      /* はみ出し防止 */
    border: 4px solid #fff; /* 白い枠線 */
    box-shadow: 0 5px 15px rgba(0,0,0,0.1); /* 影 */
    background-color: #eee; /* 画像がない時の背景色 */
    position: relative;
}

/* 画像自体の設定 */
.member-img-wrapper img,
.member-card img { /* 既存のクラスにも適用 */
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;     /* ★重要: 縦横比を維持して枠いっぱいにする */
    object-position: center top !important; /* 顔が見えるように上寄り中心でトリミング */
    border-radius: 0 !important; /* 親要素で丸くしているので子はリセット */
}

/* --- 2. 下層ページヒーロー (トップページ風背景の復活) --- */
.page-hero-modern {
    position: relative;
    height: 40vh;          /* 高さを確保 */
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    margin-bottom: 3rem;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    background-color: #1A71BE; /* 画像読み込み前の背景色 */
}

/* 背景を暗くするオーバーレイ (文字を読みやすくする) */
.page-hero-modern::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    /* 青みがかった暗いグラデーション */
    background: linear-gradient(135deg, rgba(26, 113, 190, 0.85), rgba(0, 0, 0, 0.5));
    z-index: 1;
}

.page-hero-text {
    position: relative;
    z-index: 2;
}

.page-hero-text h2 {
    font-family: 'Poppins', sans-serif;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0;
    text-shadow: 0 4px 10px rgba(0,0,0,0.3);
    color: white; /* 文字色は白 */
    text-transform: uppercase;
}

.page-hero-text p {
    color: rgba(255, 255, 255, 0.95);
    font-size: 1.1rem;
    font-weight: bold;
    margin-top: 0.8rem;
    letter-spacing: 0.1em;
}

/* --- 3. ニュースリストの崩れ修正 --- */
.news-list-container {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 0;
    max-height: 400px; /* 高さを制限 */
    overflow-y: auto;  /* スクロールさせる */
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
}

.news-list {
    margin: 0;
    padding: 0;
    list-style: none;
}

.news-list li {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #f0f0f0;
    display: flex;
    align-items: center; /* 縦位置中央揃え */
    flex-wrap: wrap;     /* スマホで折り返し */
}

.news-list li:last-child {
    border-bottom: none;
}

.news-list .date {
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    color: #1A71BE;
    margin-right: 1.5rem;
    min-width: 100px;
}

.news-list a {
    color: #333;
    font-weight: 500;
    text-decoration: none;
    flex: 1; /* 残りの幅を使う */
    display: inline-block;
}

.news-list a:hover {
    color: #1A71BE;
    text-decoration: underline;
}

/* スマホ対応 */
@media (max-width: 768px) {
    .news-list li {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.3rem;
    }
    .news-list .date {
        margin-right: 0;
        font-size: 0.85rem;
        opacity: 0.8;
    }
}

