    width: 4px;
    height: 16px;
    background: #1A71BE;
    border-radius: 2px;
}

.member-bio-modern p {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.7;
    margin-bottom: 0.5rem;
}

/* --- アドバイザー（特別顧問）専用の調整 --- */
/* 特別顧問は1人なので、少し幅広で特別感を出す */
#advisors .modern-member-grid {
    display: flex;
    justify-content: center;
}

#advisors .modern-member-card {
    max-width: 600px; /* 横幅を広めに */
